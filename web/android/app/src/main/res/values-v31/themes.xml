<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Amazonia" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/jungle_dark</item>
        <item name="android:statusBarColor">@color/jungle_dark</item>
        <item name="android:navigationBarColor">@color/jungle_dark</item>
        <item name="android:windowNoTitle">true</item>
        <!-- the launch screen: the globe on the jungle's green -->
        <item name="android:windowSplashScreenBackground">@color/jungle_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
